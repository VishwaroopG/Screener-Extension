{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screener-editorial",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "7,22,37,52 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screener-editorial",
      "database_id": "eb67a1af-7b62-47e2-b3bf-440c22cee3d4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "VishwaroopG/Screener-Extension",
    "GITHUB_REF": "main",
    "SITE_URL": "https://vishwaroopg.github.io/Screener-Extension",
    "TELEGRAM_OWNER_ID": "824171961",
    "TELEGRAM_CHAT_ID": "824171961",
    "MAX_DRAFTS_PER_DAY": "6",
    "MAX_MODEL_CALLS_PER_DAY": "24",
    "DRAFT_TTL_HOURS": "12",
    "ENABLED": "true"
  }
}
