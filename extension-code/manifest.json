{
  "manifest_version": 3,
  "name": "Screener Pro – Live Watchlist & Ticker",
  "version": "2.0.68",
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "description": "Live Indian & Global stock watchlist, draggable portfolios, and ticker tape. Support: buymeacoffee.com/vgexperiments",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.screener.in/*",
    "*://*.yahoo.com/*",
    "*://news.google.com/*",
    "https://www.nseindia.com/*"
  ],
  "action": {
    "default_title": "Open Screener Watchlist"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Screener Side Panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ticker_tape.js"
      ],
      "css": [
        "ticker_tape.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}